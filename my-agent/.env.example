# Fill these in privately. All three LiveKit values must belong to one project.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Nebius Token Factory pays for language and vision inference.
NEBIUS_API_KEY=YOUR_NEBIUS_API_KEY
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=google/gemma-3-27b-it
# Deepgram STT and Cartesia TTS use the LiveKit credentials above and LiveKit billing.

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=YOUR_AGENT_NAME

# Search (optional: Keenable supports a rate-limited keyless mode).
KEENABLE_API_KEY=

# Optional speech overrides. These defaults use LiveKit inference.
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=en
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Only needed for outbound calls from the local consent page.
CHERT_API_KEY=YOUR_CHERT_API_KEY
CHERT_PROJECT_ID=YOUR_CHERT_PROJECT_ID
CHERT_LINE_ID=YOUR_CHERT_LINE_ID
CHERT_TEST_PHONE=YOUR_VERIFIED_PHONE_IN_E164
PORT=3000
