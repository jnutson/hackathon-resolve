{
  "name": "resolve-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "web": "node --env-file=.env.local web/server.mjs",
    "simulate": "node support/simulate.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node support/run-agent.mjs",
    "check": "node --check agent.mjs && node --check greet.mjs && node --check models.mjs && node --check support/check-models.mjs",
    "check:models": "node --env-file=.env.local support/check-models.mjs",
    "help": "node agent.mjs --help",
    "check:keenable": "node --env-file=.env.local support/check-keenable.mjs",
    "check:voice": "node --env-file=.env.local support/check-voice-session.mjs"
  },
  "dependencies": {
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/rtc-node": "0.13.35",
    "keenable": "0.1.2",
    "livekit-server-sdk": "2.19.0"
  },
  "devDependencies": {
    "@trychert/facetime": "0.1.0-beta.10"
  },
  "packageManager": "pnpm@11.25.0"
}
